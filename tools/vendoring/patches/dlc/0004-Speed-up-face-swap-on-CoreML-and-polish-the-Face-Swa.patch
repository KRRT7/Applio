From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Turcios <turcioskevinr@gmail.com>
Date: Thu, 12 Nov 2026 21:54:58 -0500
Subject: [PATCH] Speed up face swap on CoreML and polish the Face Swap tab

Vendored Deep-Live-Cam changes:

- onnx_optimize: new pass that drops Expand(s, Shape(t)) feeding only
  Add/Mul/Sub/Div with an operand of t's shape. HyperSwap's 42
  Shape/Expand pairs fell back to CPU and split the graph; it now runs as
  a single CoreML partition, 60 ms -> 23 ms per swap on an M3. Live
  pipeline (HyperSwap 1c, 320 det): 16.9 -> 36.2 fps. Output is not
  bit-identical (ORT CPU rounding, ~1e-3 on [-1, 1]); identity score on
  the benchmark set is unchanged.
- onnx_optimize: pinning a dynamic input shape now produces a cached
  static copy on its own.
- face_analyser: load only the three buffalo_l models used (detection,
  recognition, 106-point landmarks) instead of letting FaceAnalysis
  compile every .onnx in the pack, and give recognition/landmarks static
  input shapes on CoreML. Analyser startup 5.6 s -> 2.1 s; embeddings and
  landmarks match the CPU reference.

Face Swap tab: stop repeating camera/virtual-camera info in the status
line (show other library messages for 5 s), and give "Async swap" its
own row.

Applio-Commit: 0567f80b90b3882fa0675053508c33ed3ff3445f
---
 _vendor/modules/face_analyser.py |  44 +++++++++++--
 _vendor/modules/onnx_optimize.py | 109 +++++++++++++++++++++++++++++++
 2 files changed, 148 insertions(+), 5 deletions(-)

diff --git a/_vendor/modules/face_analyser.py b/_vendor/modules/face_analyser.py
index b6f9108..ddb89cc 100644
--- a/_vendor/modules/face_analyser.py
+++ b/_vendor/modules/face_analyser.py
@@ -35,6 +35,44 @@ def reset_face_analyser() -> None:
         FACE_ANALYSER = None
 
 
+# The buffalo_l files the pipeline uses: detection (every live frame),
+# recognition (source-face embedding) and 106-point landmarks (mouth mask).
+# The pack's 1k3d68 and genderage models are not used.
+_ANALYSER_MODEL_FILES = ("det_10g.onnx", "w600k_r50.onnx", "2d106det.onnx")
+# Fixed input shapes for the batch-dynamic models, so CoreML gets a static
+# graph (the detector gets the same treatment in _optimize_det_model).
+_STATIC_INPUT_SHAPES = {"w600k_r50.onnx": (1, 3, 112, 112), "2d106det.onnx": (1, 3, 192, 192)}
+
+
+def _build_face_analysis(providers) -> Any:
+    """A FaceAnalysis that loads only _ANALYSER_MODEL_FILES.
+
+    insightface's FaceAnalysis(allowed_modules=...) still creates a session
+    for every .onnx in the pack folder before filtering, including the
+    unused models and the cached ``det_10g_coreml*`` copies, which on CoreML
+    means several wasted compiles at startup.
+    """
+    model_dir = os.path.join(os.path.expanduser("~"), ".insightface", "models", "buffalo_l")
+    analyser = insightface.app.FaceAnalysis.__new__(insightface.app.FaceAnalysis)
+    analyser.model_dir = model_dir
+    analyser.models = {}
+    from _vendor.modules.onnx_optimize import IS_APPLE_SILICON, optimize_for_coreml
+
+    uses_coreml = any(
+        (p[0] if isinstance(p, tuple) else p) == "CoreMLExecutionProvider" for p in providers
+    )
+    for filename in _ANALYSER_MODEL_FILES:
+        path = os.path.join(model_dir, filename)
+        if IS_APPLE_SILICON and uses_coreml and filename in _STATIC_INPUT_SHAPES:
+            path = optimize_for_coreml(path, input_shape=_STATIC_INPUT_SHAPES[filename])
+        model = insightface.model_zoo.get_model(path, providers=providers)
+        if model is None:
+            raise RuntimeError(f"insightface did not recognise {filename}")
+        analyser.models[model.taskname] = model
+    analyser.det_model = analyser.models["detection"]
+    return analyser
+
+
 def get_face_analyser() -> Any:
     """Get face analyser with thread-safe initialization."""
     global FACE_ANALYSER
@@ -54,11 +92,7 @@ def get_face_analyser() -> Any:
 
                 ensure_insightface_pack('buffalo_l')
                 providers = build_provider_config()
-                analyser = insightface.app.FaceAnalysis(
-                    name='buffalo_l',
-                    providers=providers,
-                    allowed_modules=['detection', 'recognition', 'landmark_2d_106']
-                )
+                analyser = _build_face_analysis(providers)
                 det_size = _current_det_size()
                 analyser.prepare(ctx_id=0, det_size=det_size)
                 _optimize_det_model(analyser, providers, det_size)
diff --git a/_vendor/modules/onnx_optimize.py b/_vendor/modules/onnx_optimize.py
index a49d023..ab4e7de 100644
--- a/_vendor/modules/onnx_optimize.py
+++ b/_vendor/modules/onnx_optimize.py
@@ -25,6 +25,16 @@ would otherwise introduce:
    ``[1]`` and squeeze the added axis on the Gather output.
    (Filed upstream as microsoft/onnxruntime#28180.)
 
+5. **Broadcast-redundant Expand removal** — Style-modulated models
+   (HyperSwap's AdaIN-style blocks) compute ``Op(t, Expand(s, Shape(t)))``
+   with Op in {Add, Mul, Sub, Div}. The runtime ``Shape`` falls back to CPU
+   and splits the graph, yet the ``Expand`` is redundant: the binary op
+   broadcasts ``s`` against ``t`` to the same shape. We feed ``s`` directly.
+   Same math, but not bit-identical: ORT's CPU kernels round broadcast and
+   pre-expanded operands slightly differently (~1e-6 per rewritten op),
+   which compounds to ~1e-3 on HyperSwap's [-1, 1] output (< 1/8 of an
+   8-bit level).
+
 All passes are cached on disk with a ``_coreml`` suffix (plus the input shape
 when one is given, e.g. ``_coreml_1x3x320x320``) so the rewrite cost
 is paid only once per model and shape.
@@ -71,6 +81,11 @@ def optimize_for_coreml(model_path: str, input_shape: tuple = None) -> str:
     model = onnx.load(model_path)
     changed = False
 
+    # Pinning a dynamic input (e.g. batch "None") to input_shape is itself
+    # worth a cached copy: CoreML compiles static graphs without fallbacks.
+    if input_shape is not None and _pin_input_shape(model, input_shape):
+        changed = True
+
     if _fold_shape_gather(model, input_shape):
         changed = True
 
@@ -87,6 +102,10 @@ def optimize_for_coreml(model_path: str, input_shape: tuple = None) -> str:
     if _rewrite_scalar_gather(model):
         changed = True
 
+    # Each removal can make further shapes inferable; repeat to a fixpoint.
+    while _drop_broadcast_expand(model):
+        changed = True
+
     if not changed:
         return model_path
 
@@ -99,6 +118,20 @@ def optimize_for_coreml(model_path: str, input_shape: tuple = None) -> str:
     return optimized_path
 
 
+def _pin_input_shape(model, input_shape) -> bool:
+    """Set the first graph input's dims to input_shape; True if any changed."""
+    dims = model.graph.input[0].type.tensor_type.shape.dim
+    if len(dims) != len(input_shape):
+        return False
+    changed = False
+    for dim, value in zip(dims, input_shape):
+        if not (dim.HasField("dim_value") and dim.dim_value == value):
+            dim.Clear()
+            dim.dim_value = value
+            changed = True
+    return changed
+
+
 # ---------------------------------------------------------------------------
 # Pass 1: Fold Shape → Gather chains into constants
 # ---------------------------------------------------------------------------
@@ -537,6 +570,82 @@ def _rewrite_scalar_gather(model) -> bool:
 # Helpers
 # ---------------------------------------------------------------------------
 
+def _drop_broadcast_expand(model) -> bool:
+    """Remove ``Expand(s, Shape(t))`` feeding only ``Op(t, ·)`` broadcasts.
+
+    Only rewrites when every consumer of the Expand is an elementwise
+    Add/Mul/Sub/Div whose other operand is ``t`` itself (the tensor whose
+    shape the Expand targets) or a tensor whose fully static inferred shape
+    equals ``t``'s. Broadcasting ``s`` against that operand then yields the
+    same shape the Expand would have produced. Shape nodes left without
+    consumers are removed too.
+    """
+    import onnx
+
+    graph = model.graph
+    try:
+        inferred = onnx.shape_inference.infer_shapes(model, data_prop=True).graph
+    except Exception:
+        inferred = graph
+    static = {}
+    for vi in list(inferred.value_info) + list(inferred.input) + list(inferred.output):
+        dims = vi.type.tensor_type.shape.dim
+        if dims and all(d.HasField("dim_value") and d.dim_value > 0 for d in dims):
+            static[vi.name] = tuple(d.dim_value for d in dims)
+
+    def same_shape(a, b):
+        return a == b or (a in static and static.get(a) == static.get(b))
+
+    producer = {out: node for node in graph.node for out in node.output}
+    consumers = {}
+    for node in graph.node:
+        for name in node.input:
+            consumers.setdefault(name, []).append(node)
+    graph_outputs = {o.name for o in graph.output}
+
+    removed = set()
+    for node in graph.node:
+        if node.op_type != "Expand" or len(node.input) != 2:
+            continue
+        shape_node = producer.get(node.input[1])
+        if shape_node is None or shape_node.op_type != "Shape" or len(shape_node.attribute):
+            continue  # Shape with start/end attributes is a slice; skip
+        target = shape_node.input[0]
+        out = node.output[0]
+        uses = consumers.get(out, [])
+        if not uses or out in graph_outputs:
+            continue
+        def other(use):
+            a, b = use.input
+            return b if a == out else a
+
+        ok = all(
+            use.op_type in ("Add", "Mul", "Sub", "Div")
+            and len(use.input) == 2
+            and out in use.input
+            and other(use) != out
+            and same_shape(other(use), target)
+            for use in uses
+        )
+        if not ok:
+            continue
+        for use in uses:
+            for i, name in enumerate(use.input):
+                if name == out:
+                    use.input[i] = node.input[0]
+        removed.add(id(node))
+
+    if not removed:
+        return False
+
+    kept = [n for n in graph.node if id(n) not in removed]
+    used = {name for n in kept for name in n.input} | graph_outputs
+    kept = [n for n in kept if not (n.op_type == "Shape" and n.output[0] not in used)]
+    del graph.node[:]
+    graph.node.extend(kept)
+    return True
+
+
 def _preserve_emap_position(model, numpy_helper):
     """Keep the insightface emap (512×512 matrix) as the last initializer."""
     graph = model.graph
