+        self._freeze_logged = False
 
     def process(self, frame: Frame) -> Frame:
         return self.render(self.detect(frame))
@@ -328,6 +367,7 @@ class FramePipeline:
             # a fresh detection afterwards.
             self._cached_target_face = None
