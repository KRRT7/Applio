@@ -338,17 +378,32 @@ class FramePipeline:
                 self._cached_target_face = None
                 self._cached_many_faces = detect_many_faces_fast(temp_frame)
                 self._smoother.reset()
+                self._last_face, self._cached_held = None, False
             else:
