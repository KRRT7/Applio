+class HyperSwapper:
+    """FaceFusion Labs' HyperSwap behind the INSwapper interface used here.
+
+    Inputs: source = ArcFace normed embedding (1x512), target = 256x256
+    aligned crop (arcface_128 template, RGB, scaled to [-1, 1]). Outputs the
+    swapped crop and a face mask that excludes occluders such as glasses.
+    The swapped crop is returned as BGRA with the mask in the alpha channel,
+    which paste_swapped_face() uses for blending.
+    """
+
+    def __init__(self, model_path: str, providers: list):
+        import onnxruntime
+
+        self.model_file = model_path
+        self.session = onnxruntime.InferenceSession(model_path, providers=providers)
+        self.input_size = (256, 256)
+
+    def swap_aligned(self, source_face: Face, aimg: np.ndarray) -> np.ndarray:
+        blob = cv2.dnn.blobFromImage(aimg, 1.0 / 127.5, self.input_size, (127.5, 127.5, 127.5), swapRB=True)
+        embedding = source_face.normed_embedding.reshape((1, -1)).astype(np.float32)
+        out, mask = self.session.run(None, {"source": embedding, "target": blob})
+        rgb = np.clip((out[0].transpose(1, 2, 0) + 1.0) * 127.5, 0, 255).astype(np.uint8)
+        alpha = (np.clip(mask[0, 0], 0.0, 1.0) * 255).astype(np.uint8)
+        return np.ascontiguousarray(np.dstack([rgb[:, :, ::-1], alpha]))
+
+    def get(self, img: Frame, target_face: Face, source_face: Face, paste_back: bool = False):
+        kps = np.asarray(target_face.kps, dtype=np.float32)
+        aimg, M = face_align.norm_crop2(img, kps, self.input_size[0])
+        return self.swap_aligned(source_face, aimg), M
+
+
+def _load_hyperswap(model: str) -> Any:
+    from _vendor.modules.model_downloader import ensure_model
+
+    model_path = ensure_model(f"{model}.onnx")
+    if model_path is None:
+        update_status(f"Could not obtain {model}.onnx.", NAME)
+        return None
+    if IS_APPLE_SILICON:
+        from _vendor.modules.onnx_optimize import optimize_for_coreml
+        model_path = optimize_for_coreml(model_path)
+    update_status(f"Loading face swapper model from: {model_path}", NAME)
+    try:
+        swapper = HyperSwapper(model_path, _providers_config())
+    except Exception as e:
+        update_status(f"Error loading face swapper model: {e}", NAME)
+        return None
+    update_status("Face swapper model loaded successfully.", NAME)
+    return swapper
+
