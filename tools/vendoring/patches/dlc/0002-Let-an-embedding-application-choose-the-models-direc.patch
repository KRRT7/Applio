+++ b/_vendor/modules/processors/frame/face_enhancer_gpen512.py
@@ -31,9 +31,7 @@ ENHANCER = None
 THREAD_LOCK = threading.Lock()
 
 abs_dir = os.path.dirname(os.path.abspath(__file__))
-models_dir = os.path.join(
-    os.path.dirname(os.path.dirname(os.path.dirname(abs_dir))), "models"
-)
+from _vendor.modules.paths import MODELS_DIR as models_dir  # noqa: E402
 
 
 def _obtain_model():
diff --git a/_vendor/modules/processors/frame/face_swapper.py b/_vendor/modules/processors/frame/face_swapper.py
index b949850..f35ce1a 100644
--- a/_vendor/modules/processors/frame/face_swapper.py
+++ b/_vendor/modules/processors/frame/face_swapper.py
@@ -194,9 +194,7 @@ ADAPTIVE_QUALITY = True
 # --- END: Mac M1-M5 Optimizations ---
 
 abs_dir = os.path.dirname(os.path.abspath(__file__))
-models_dir = os.path.join(
-    os.path.dirname(os.path.dirname(os.path.dirname(abs_dir))), "models"
-)
+from _vendor.modules.paths import MODELS_DIR as models_dir  # noqa: E402
 
